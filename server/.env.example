# Copy this file to .env (same folder) for local development:
#   cp .env.example .env
# .env is git-ignored. In production, set these on the host's dashboard
# and use DIFFERENT passwords from the ones below (this file is public).
#
# Rules: 4-40 characters, letters, digits and dashes only, all 5 different.

LEVEL1_PASSWORD=SUNFLOWER
LEVEL2_PASSWORD=MARBLE-OWL
LEVEL3_PASSWORD=VELVET-COMET
LEVEL4_PASSWORD=IRON-LANTERN
LEVEL5_PASSWORD=QUIET-GLACIER

# Optional (defaults shown). How many proxies sit in front of Express:
# 0 on your laptop, 1 on Render. Wrong values weaken the rate limit.
TRUST_PROXY=0
# Most AI calls per day (UTC) for the whole app, across all players.
DAILY_AI_CALL_LIMIT=800

# Groq API key (secret!). Get one at console.groq.com. Never commit the real one.
GROQ_API_KEY=
# Optional: which models play the guard and the Level 5 reviewer (defaults shown)
GUARD_MODEL=allam-2-7b
REVIEWER_MODEL=openai/gpt-oss-120b
